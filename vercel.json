{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "client/user-portal/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
