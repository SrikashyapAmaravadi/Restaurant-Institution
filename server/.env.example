PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth — use a 32+ character random secret in every environment
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS="7"
OTP_PEPPER="replace-with-a-second-long-random-secret"

# Comma-separated browser origins allowed to call the API with cookies
CORS_ORIGINS="http://localhost:1574,https://your-production-domain.example"

# Transactional email (required in production — Resend API key takes priority if set, otherwise SMTP)
RESEND_API_KEY="" # e.g. re_123456789
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Dine Security <sahi0045@hotmail.com>"

# Payments — omit to disable online checkout (cash/UPI QR still work)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional Google SSO (ID token audience)
GOOGLE_CLIENT_ID=""

# Protects POST /health/trigger-reminders
CRON_SECRET="replace-with-random-cron-secret"

# Development only: echo OTP in JSON when SMTP is unset
OTP_ECHO="false"
